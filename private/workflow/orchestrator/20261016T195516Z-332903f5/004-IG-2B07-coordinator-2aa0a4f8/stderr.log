  "findings": [
    {
      "id": "F01",
      "severity": "medium",
      "title": "Second page-28 diagram omits the upper black arrow beside Phalanx B from component accounting",
      "location": {
        "artifact": "private/workflow/runs/IG-2B07/inventory-25-28-01/component-ledger.json",
        "parent_region_id": "region:93a4c97f-54e6-4b11-95c2-f0a704491226",
        "parent_key": "ig2b07:p28-diagram-after",
        "physical_page": 28,
        "source_sha256": "e5b65958ca04261058147966b10e1ab2785061fc50060390f8a4ce0e34c6d69e",
        "inspection_box": [
          695000,
          272000,
          738000,
          301000
        ],
        "coordinate_basis": "Unrotated effective CropBox, top-left integer page millionths"
      },
      "observation": "The original second diagram visibly retains a black arrow pointing down/right from the upper right edge of B toward the now-empty hex to its right. The frozen component ledger lists after-aa, after-au, after-av, after-bx, after-cy and after-cz, but no distinct upper-B-arrow component. It is visible in the full parent/grid image and partly in the B-counter crop; neither substitutes for the required separate component locator. The separate yellow rout arrow is already present and is a different visible component. This is a visual accounting observation, with no gameplay legality determination.",
      "consequence": "The claim that every external arrow has a separate crop is false, and all 86-component/188-target set-equality checks reproduce an incomplete authored set.",
      "affected_criteria": [
        "Account for every page region: clauses, headings, notes, examples, diagrams, tables/legends and editorial exclusions.",
        "Keep exact evidence locators, uncertain readings and cross-page continuations; no silent omission.",
        "Freshly inspect every original assigned page, column, note, example, diagram and component; pin exact source/page/box evidence for all new regions and components, uncertainty and explicit gaps. Boundary context is limited to the authorized page-24 bottom and page-29 top strips and contributes zero denominator.",
        "Freeze final-verified/inventory.json and identity-registry.json plus all root reports named in the refined contract under the new owned inventory-25-28-01 attempt. Keep complete full/task/context denominators separate and retain the persisted registry binding.",
        "Generate evidence serially and complete two separate independent full replays, preserving every new region/component and checking complete target-set equality, stable IDs, evidence freshness, reading order, links and path-normalized output comparisons."
      ],
      "evidence": [
        {
          "path": "private/workflow/runs/IG-2B07/review-3f57d66e-01/originals/p28-after-b-upper-arrow.png",
          "sha256": "10cafa295ad8e9a5c450c70630a70419a940cbd2b403dc1f28f999af7db7258b",
