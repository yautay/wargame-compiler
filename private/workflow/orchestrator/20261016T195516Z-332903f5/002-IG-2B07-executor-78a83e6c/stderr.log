+paths += [Path(p['path']) for p in load(A/'originals/pins.json')]
+paths += [Path(p['path']) for p in load(A/'inspection-sheets/index.json')]
+paths += [Path(p['path']) for run in replay['runs'] for p in run['output_pins']]
