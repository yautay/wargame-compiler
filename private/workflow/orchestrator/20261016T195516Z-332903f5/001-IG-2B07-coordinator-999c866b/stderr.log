{"task": "IG-2B07", "path": "scripts/workflow.py", "start_line": 149, "lines": ["materials, authorized semantic reviewer and performance hardware/thresholds must be", "pinned in the tasks that need them; they do not prevent the first source-contract task.", "", "External history relocation remains governed by [the archive register](ARCHIVES.md)", "and the queue infrastructure blockers. No archive content is needed for this packet.", "Do not use old prompts, archived operational approvals or Git history as default context.", "'''", "    return {'docs/ROADMAP.md':'\\n'.join(rows)+'\\n', 'docs/STATUS.md':status,", "            'docs/HANDOFF.md':handoff, **{f'docs/work/tasks/{t[\"id\"]}.md':card(t) for t in q['tasks']}}", "", "def validate(q, root, check_views=True):", "    if q.get('schema_version') != 'wgc-work-1': raise ValueError('Unknown queue format')", "    tasks = q['tasks']; ids = [t['id'] for t in tasks]", "    if len(ids) != len(set(ids)): raise ValueError('Duplicate task ID')", "    by_id = {t['id']:t for t in tasks}", "    if sum(t['status'] in BUSY for t in tasks) > 1: raise ValueError('Sequential writer/review ownership conflict')", "    visited, visiting = set(), set()", "    def visit(id):", "        if id in visiting: raise ValueError(f'Dependency cycle at {id}')", "        if id in visited: return", "        visiting.add(id)", "        for dep in by_id[id]['depends']:", "            if dep not in by_id: raise ValueError(f'Missing dependency {dep}')", "            visit(dep)", "        visiting.remove(id); visited.add(id)", "    for t in tasks:", "        if not re.fullmatch(r'IG-[1-5][A-Z][0-9]*(?:-[A-Z0-9]+)*', t['id']): raise ValueError('Invalid task ID')", "        if t['status'] not in TRANSITIONS: raise ValueError('Invalid status')", "        if t['kind'] not in {'implementation','content','refine','closure'}: raise ValueError('Invalid kind')", "        if t['executor'] != {'model':'GPT-6.1 Sol','model_id':'gpt-6.1-sol','reasoning':'high'}: raise ValueError('Unexpected executor target')", "        for field in ('goal','outputs','start_conditions','inputs','write_scope','exclusions','acceptance','tests','blockers','handoff'):", "            if not t.get(field) or (isinstance(t[field],list) and not all(isinstance(x,str) and x.strip() for x in t[field])):", "                raise ValueError(f'{t[\"id\"]}: missing {field}')", "        visit(t['id'])", "        for rel in t['context']:", "            if not permitted(root, rel): raise ValueError(f'Forbidden context: {rel}')", "            if t['status'] != 'planned' and not safe_path(root,rel).is_file(): raise ValueError(f'Missing context: {rel}')", "        for rel in t['write_scope']:", "            safe_path(root,rel)", "            if denied(rel): raise ValueError(f'History in write scope: {rel}')", "        if t['status'] in {'ready', *BUSY, 'done'}:", "            if t['kind']=='refine': raise ValueError(f'{t[\"id\"]} requires refinement')", "            if any(by_id[d]['status']!='done' for d in t['depends']): raise ValueError(f'{t[\"id\"]} has unfinished dependencies')", "        if t['status'] in BUSY | {'done','blocked'} and not t['events']:", "            raise ValueError('Active/finished/blocked task requires transition evidence')", "        previous = None", "        for event in t['events']:", "            if event['to'] not in TRANSITIONS.get(event['from'],set()) or (previous and previous != event['from']):", "                raise ValueError('Invalid event chain')", "            previous = event['to']", "            p = safe_path(root,event['evidence'])", "            if not p.is_file() or digest(p)!=event['sha256']: raise ValueError('Transition evidence changed or missing')", "            if 'semantic_decision' in event:", "                decision=safe_path(root,event['semantic_decision'])", "                if not decision.is_file() or digest(decision)!=event['semantic_sha256']: raise ValueError('Semantic decision changed')", "        if previous and previous != t['status']: raise ValueError('Status disagrees with event chain')", "    if check_views:", "        for rel,body in views(q).items():", "            p=root/rel", "            if not p.is_file() or p.read_text(encoding='utf-8')!=body: raise ValueError(f'Derived view stale: {rel}; run render')", "    return len(tasks)", "", "def packet(q, root, task_id, output=True):", "    task = next(t for t in q['tasks'] if t['id']==task_id)", "    if task['status'] not in {'ready', *BUSY}: raise ValueError('Task is not ready or active')", "    validate(q,root)", "    paths = list(dict.fromkeys(BASE_CONTEXT+[f'docs/work/tasks/{task_id}.md']+task['context']))", "    files, sections = [], []", "    for rel in paths:", "        if not permitted(root,rel): raise ValueError(f'Forbidden context: {rel}')", "        p=safe_path(root,rel)", "        if not p.is_file(): raise ValueError(f'Missing context: {rel}')", "        files.append({'path':rel,'bytes':p.stat().st_size,'sha256':digest(p)})", "        if p.suffix.lower() in {'.md','.json','.py','.ps1','.toml'}:", "            sections.append(f'\\n--- FILE: {rel} ---\\n'+p.read_text(encoding='utf-8-sig'))", "    payload = '\\n'.join(sections)", "    if len(payload.encode('utf-8'))>100_000: raise ValueError('Packet exceeds 100 KB; narrow exact context instead of truncating')", "    result={'format':'wgc-context-1','task':task_id,'queue_sha256':digest(root/QUEUE),", "            'files':files,'text_bytes':len(payload.encode('utf-8')),'tokens':None,", "            'token_note':'Not measured; bytes are not tokens.','external_inputs':task['inputs']}"], "truncated": true}

