{"task": "IG-2B06", "path": "src/wgc/sources/inventory.py", "start_line": 1, "lines": ["\"\"\"Persisted page/region identities, exact revisions and coverage accounting.\"\"\"", "from __future__ import annotations", "import copy", "import hashlib", "import uuid", "from pathlib import Path", "from wgc.contracts.source import canonical_bytes, load_json, _check_schema, _shape", "from .geometry import SCALE, check_box, effective_crop, overlaps, area", "", "SCHEMA = Path(__file__).resolve().parents[3] / 'contracts/ig/regions.schema.json'", "LEVELS = ('transcription', 'descriptive_semantics', 'formal_semantics')", "STATUSES = ('represented', 'partial', 'unprocessed', 'excluded')", "", "", "def digest(value):", "    return hashlib.sha256(canonical_bytes(value)).hexdigest()", "", "", "def seal(record):", "    record = copy.deepcopy(record)", "    record['revision'] = digest({k:v for k,v in record.items() if k != 'revision'})", "    return record", "", "", "def check_revision(record):", "    if record['revision'] != seal(record)['revision']:", "        raise ValueError('revision hash mismatch')", "", "", "def new_registry(source_id, source_revision):", "    return {'format':'wgc-source-identities-1', 'source_id':source_id,", "            'source_revision':source_revision, 'entries':[]}", "", "", "def validate_registry(registry):", "    if set(registry) != {'format','source_id','source_revision','entries'} or registry['format'] != 'wgc-source-identities-1':", "        raise ValueError('invalid persisted registry')", "    keys, ids = set(), set()", "    for entry in registry['entries']:", "        if set(entry) != {'kind','key','id'} or entry['kind'] not in ('page','region') or not isinstance(entry['key'],str) or not entry['key']:", "            raise ValueError('invalid registry entry')", "        key = (entry['kind'],entry['key'])", "        if key in keys or entry['id'] in ids:", "            raise ValueError('duplicate registry identity/key')", "        if not entry['id'].s