+                if q['page_id']==r['page_id'] and q['denominator_role']=='inventory':
+                    assert not overlaps(q['box'],r['box']),(q['key'],r['key'])
+    return result
+
+
+def ordered_specs(page):
+    items=[s for s in SPECS if s['page']==page]
