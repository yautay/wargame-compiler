+    # field tiles; all overlapping detail crops remain outside the denominator.
+    left=[];right=[];head=[];foot=[]
+    for s in items:
+        key=s['key'].split(':',2)[2]
+        if key=='running-header':head.append(s)
+        elif key=='copyright':foot.append(s)
