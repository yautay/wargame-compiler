+
+def sha(p):
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+
+
+def pin(p):
+    p = Path(p)
+    return dict(path=p.as_posix(), bytes=p.stat().st_size, sha256=sha(p))
