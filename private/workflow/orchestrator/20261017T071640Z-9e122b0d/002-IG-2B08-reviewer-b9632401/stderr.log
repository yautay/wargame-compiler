+def pins_in(obj):
+    if isinstance(obj, dict):
+        if 'path' in obj and 'sha256' in obj:
+            yield obj
+        for val in obj.values():
+            yield from pins_in(val)
+    elif isinstance(obj, list):
+        for val in obj:
+            yield from pins_in(val)
