import json,hashlib,pathlib
root=pathlib.Path('.'); session=root/'private/workflow/orchestrator/20261016T154824Z-fae43db9/002-IG-2B05-reviewer-d526bcf5'; run=root/'private/workflow/runs/IG-2B05/review-d526bcf5-01'
run.mkdir(exist_ok=False)
def pin(p):
 b=pathlib.Path(p).read_bytes();return {'path':str(p).replace('\\\\','/'),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
packet=json.loads((session/'packet.json').read_text()); errors=[]; n=0
for item in packet['files']+packet['control_files']:
 p=root/item['path']
 if item['path'] in ['docs/STATUS.md','docs/HANDOFF.md']:p=session/'bootstrap'/pathlib.Path(item['path']).name
 got=pin(p);n+=1
 if any(got[k]"'!=item[k] for k in ('"'bytes','sha256')):errors.append(item['path'])
dref=json.loads((session/'delivery-reference.json').read_text()); delivery=pathlib.Path(dref['evidence']); assert pin(delivery)['sha256']==dref['sha256']
d=json.loads(delivery.read_text()); bad=[]
for a in d['artifacts']:
 try:
  got=pin(a['path'])
  if any(got[k]"'!=a[k] for k in ('"'bytes','sha256')):bad.append({'path':a['path'],'actual':got})
 except Exception as e:bad.append({'path':a['path'],'error':str(e)})
result={'packet_file_checks':n,'packet_errors':errors,'delivery':pin(delivery),'artifact_count':len(d['artifacts']),'artifact_errors':bad,'configuration':pin(session/'runtime-configuration.json')}
(run/'hash-audit.json').write_text(json.dumps(result,indent=2)+'\\n')
print(json.dumps(result))
print('delivery fields',list(d)); print('criteria_equal',d['criteria']==json.loads((session/'task.json').read_text())['acceptance'])
