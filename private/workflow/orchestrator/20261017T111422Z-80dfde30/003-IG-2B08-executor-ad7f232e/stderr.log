def normalized_evidence(doc):
    ids={r['id'] for r in new_regions(doc)}
    rows=[]
    for e in doc['evidence']:
        if e['region_id'] not in ids:continue
        e=copy.deepcopy(e)
        for field in ('crop_pdf','text','image'):
            e[field]['path']=e[field]['path'].split('/evidence/',1)[1]
        rows.append(e)
    return rows


