{"task": "IG-2B08", "path": "src/wgc/sources/inventory.py", "start_line": 1, "lines": ["\"\"\"Persisted page/region identities, exact revisions and coverage accounting.\"\"\"", "from __future__ import annotations", "import copy", "import hashlib", "import uuid", "from pathlib import Path", "from wgc.contracts.source import canonical_bytes, load_json, _check_schema, _shape", "from .geometry import SCALE, check_box, effective_crop, overlaps, area", "", "SCHEMA = Path(__file__).resolve().parents[3] / 'contracts/ig/regions.schema.json'", "LEVELS = ('transcription', 'descriptive_semantics', 'formal_semantics')", "STATUSES = ('represented', 'partial', 'unprocessed', 'excluded')", "", "", "def digest(value):", "    return hashlib.sha256(canonical_bytes(value)).hexdigest()", "", "", "def seal(record):", "    record = copy.deepcopy(record)", "    record['revision'] = digest({k:v for k,v in record.items() if k != 'revision'})", "    return record", "", "", "def check_revision(record):", "    if record['revision'] != seal(record)['revision']:", "        raise ValueError('revision hash mismatch')", "", "", "def new_registry(source_id, source_revision):", "    return {'format':'wgc-source-identities-1', 'source_id':source_id,", "            'source_revision':source_revision, 'entries':[]}", "", "", "def validate_registry(registry):", "    if set(registry) != {'format','source_id','source_revision','entries'} or registry['format'] != 'wgc-source-identities-1':", "        raise ValueError('invalid persisted registry')", "    keys, ids = set(), set()", "    for entry in registry['entries']:", "        if set(entry) != {'kind','key','id'} or entry['kind'] not in ('page','region') or not isinstance(entry['key'],str) or not entry['key']:", "            raise ValueError('invalid registry entry')", "        key = (entry['kind'],entry['key'])", "        if key in keys or entry['id'] in ids:", "            raise ValueError('duplicate registry identity/key')", "        if not entry['id'].startswith(entry['kind']+':'):", "            raise ValueError('identity kind mismatch')", "        try: uuid.UUID(entry['id'].split(':',1)[1])", "        except (ValueError, AttributeError): raise ValueError('invalid registry UUID') from None", "        keys.add(key); ids.add(entry['id'])", "", "", "def assign(registry, kind, key):", "    validate_registry(registry)", "    if kind not in ('page','region') or not isinstance(key,str) or not key:", "        raise ValueError('explicit nonempty identity key required')", "    for entry in registry['entries']:", "        if entry['kind'] == kind and entry['key'] == key: return entry['id']", "    identity = kind+':'+str(uuid.uuid4())", "    registry['entries'].append({'kind':kind,'key':key,'id':identity})", "    registry['entries'].sort(key=lambda e:(e['kind'],e['key']))", "    return identity", "", "", "def make_region(registry, key, page, box, *, kind='unclassified', role='inventory', reason='Not yet inventoried'):", "    check_box(box)", "    return seal({'id':assign(registry,'region',key), 'key':key, 'page_id':page['id'],", "                 'source_revision':registry['source_revision'], 'box':list(box),", "                 'kind':kind, 'denominator_role':role, 'uncertainty':[reason] if reason else [],", "                 'coverage':{level:{'status':'unprocessed','reason':reason,'gap':True,'boundary':None}", "                             for level in LEVELS}})", "", "", "def assemble(source, pages, regions, registry, *, reading_order=None, links=None, evidence=None, toolchain=None):", "    result = seal({'format':'wgc-inventory-1','source':source,'pages':pages,'regions':regions,", "                   'registry':copy.deepcopy(registry),", "                   'reading_order':reading_order if reading_order is not None else [r['id'] for r in regions],", "                   'links':links or [],'evidence':evidence or [],'toolchain':toolchain or []})", "    validate(result)", "    return result", ""], "truncated": true}

