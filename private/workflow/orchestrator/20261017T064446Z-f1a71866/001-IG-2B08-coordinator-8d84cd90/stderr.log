for v in refs['dependencies'].values(): pins[v['evidence']]=v['sha256']
for name,expected in [('dependency-view.json','8ffe9a7c68dee816da8cb93bf016a2c4f9a9e80e6edb2b562083dbe59a0aff64'),('search-manifest.json','8fea527bae6474d61c98c0e9e68c9589ff27fbb4f44040c3bb2bb519e7b3447b')]:
    assert digest(session/name)==expected,name
collect(load(session/'dependency-view.json'))
for rel,expected in pins.items():
