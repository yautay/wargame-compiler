import json,hashlib
from pathlib import Path
root=Path.cwd(); session=root/'private/workflow/orchestrator/20261017T064446Z-f1a71866/001-IG-2B08-coordinator-8d84cd90'
def digest(p):
    with p.open('rb') as f: return hashlib.file_digest(f,'sha256').hexdigest()
def load(p): return json.loads(p.read_text(encoding='utf-8-sig'))
pins={}
def collect(x):
    if isinstance(x,dict):
        if isinstance(x.get('path'),str) and isinstance(x.get('sha256'),str): pins[x['path']]=x['sha256']
        for v in x.values(): collect(v)
    elif isinstance(x,list):
        for v in x: collect(v)
packet=load(session/'packet.json'); collect(packet.get('files',[])); collect(packet['control_files'])
