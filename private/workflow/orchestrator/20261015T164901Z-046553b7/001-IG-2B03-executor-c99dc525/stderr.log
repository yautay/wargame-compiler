+    assert all(next(t for t in queue['tasks'] if t['id']==dep)['status']=='done' for dep in task['depends'])
+    cmd=['.venv/Scripts/python.exe','-B','-m','wgc.sources','validate',(OUT/'final-verified/inventory.json').as_posix()]
