+ 'p12:522-item-6':['6.66'], 'p12:522-item-7':['8.64'], 'p12:522-closing':['4.35, 4.52, etc.'],
+ 'p12:523-item-1':['4.32','9.66'], 'p12:524':['6.11, 6.12'], 'p12:525':['8.4','8.1','8.2'],
