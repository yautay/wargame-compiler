+        doc=load(OUT/input_name/'inventory.json')
+        assigned={p['id'] for p in doc['pages'] if p['pdf_page'] in (9,10,11,12)}
+        regions=[r for r in doc['regions'] if r['page_id'] in assigned]
+        for i,r in enumerate(regions):
