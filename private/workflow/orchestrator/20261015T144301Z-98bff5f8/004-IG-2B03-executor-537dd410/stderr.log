+  {'command':'.venv/Scripts/python.exe -B scripts/workflow.py validate','exit_code':0,'report':pin(OUT/'workflow-validation.log')},
+  {'command':'git diff --check','exit_code':0,'report':pin(OUT/'diff-check.log')},
