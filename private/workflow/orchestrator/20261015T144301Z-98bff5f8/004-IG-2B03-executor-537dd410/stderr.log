+ for a in [doc['source']['pdf'],doc['source']['provenance'],pin(config),pin(config.parent/'packet.json'),pin(config.parent/'task.json'),pin(config.parent/'references.json'),pin(pathlib.Path(project_root)/'result.json')]:add(a)
