+def box(points):
+ x0,y0,x1,y1=points
+ return [math.floor(x0/612*1000000),math.floor(y0/792*1000000),math.ceil(x1/612*1000000),math.ceil(y1/792*1000000)]
+
+def specs():
+ rows=[]
+ for n,plan in PLAN.items():
+  lines=json.loads((OUT/f'lines-{n}.json').read_text(encoding='utf-8'))
