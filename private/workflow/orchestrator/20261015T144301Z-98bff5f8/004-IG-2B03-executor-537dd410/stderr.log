+ for y0,y1 in zip(ys,ys[1:]):
+  spans=sorted((b[0],b[2]) for b in boxes if b[1]<=y0 and b[3]>=y1);x=0
+  for a,b in spans:
+   if a>x:rects.append([x,y0,a,y1])
+   x=b
+  if x<1000000:rects.append([x,y0,1000000,y1])
+ return rects
