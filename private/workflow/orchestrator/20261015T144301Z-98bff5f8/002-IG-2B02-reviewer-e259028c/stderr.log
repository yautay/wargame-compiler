{"i": 94, "key": "ig2b02:p7:withdrawal-heading", "label": "E. Withdrawal Phase", "kind": "heading", "box": [71895, 704545, 487746, 723485], "components": ["E. Withdrawal Phase"], "uncertainty": [], "text": "E. Withdrawal Phase"}
{"i": 95, "key": "ig2b02:p7:withdrawal-prose", "label": "Withdrawal paragraph", "kind": "clause", "box": [71895, 724116, 487746, 801768], "components": ["Withdrawal paragraph"], "uncertainty": [], "text": "Each player totals the Rout Points of all eliminated combat units\nand leaders to see if his army has reached its Withdrawal Level.\nIf neither player\u2019s army withdraws, the Game Turn is concluded,\nand another Game Turn begins. The battle continues until one\nside\u2019s army withdraws."}
{"i": 96, "key": "ig2b02:p7:leaders-heading", "label": "4.0 LEADERS", "kind": "heading", "box": [513071, 67550, 928922, 93435], "components": ["4.0 LEADERS"], "uncertainty": [], "text": "4.0 LEADERS"}
{"i": 97, "key": "ig2b02:p7:leaders-introduction", "label": "Leader orders and counter sides", "kind": "clause", "box": [513071, 94065, 928922, 170455], "components": ["Leader orders and counter sides"], "uncertainty": [], "text": "Combat units cannot move or fire without receiving orders from\na leader. Each leader counter has two sides: \u201cActivated\u201d and\n\u201cFinished\u201d. A leader who has not yet been activated or is now\nactivated uses his Activated side. A leader that has concluded his\nactivation is flipped to his Finished side."}
{"i": 98, "key": "ig2b02:p7:sample-leader-diagram", "label": "Sample Leader Counter annotated diagram", "kind": "diagram", "box": [570261, 175505, 861929, 272096], "components": ["Sample Leader Counter caption", "P.Scipio name", "Portrait", "Yellow-star stripe", "Red triangle", "8 Command Range", "6 Initiative", "2 Line Command Rating", "Boxed 3 Charisma", "Red-circle 7 Strategy Rating", "Name callout and leader line", "Elite Initiative Indicator callout and leader line to triangle", "Command Range callout and leader line to 8", "Initiative callout and leader line to 6", "Line Command Rating callout and leader line to 2", "Charisma callout and leader line to boxed 3", "Strategy Rating callout and leader line to red-circle 7"], "uncertainty": [], "text": "Sample Leader Counter\nName\nElite Initiative\nIndicator Strategy Rating\nCommand Charisma\nRange\nInitiative Line Command\nRating"}
{"i": 99, "key": "ig2b02:p7:leader-counters-heading", "label": "4.1 LEADER COUNTERS", "kind": "heading", "box": [513071, 287247, 928922, 305556], "components": ["4.1 LEADER COUNTERS"], "uncertainty": [], "text": "4.1 LEADER COUNTERS"}
{"i": 100, "key": "ig2b02:p7:ratings-introduction", "label": "Leader ratings introduction", "kind": "clause", "box": [513071, 306818, 928922, 323864], "components": ["Leader ratings introduction"], "uncertainty": [], "text": "Each leader possesses several ratings:"}
{"i": 101, "key": "ig2b02:p7:rating-command-range", "label": "Command Range inline heading and paragraph", "kind": "clause", "box": [513071, 328914, 928922, 391415], "components": ["Command Range inline heading and paragraph"], "uncertainty": [], "text": "Command Range: The range in hexes over which the leader\nmay exert his Initiative. Denotes his overall presence on the\nbattlefield and the presence of his subordinates and aides as well\nas the effectiveness of his abilities."}
{"i": 102, "key": "ig2b02:p7:rating-elite-commander", "label": "Elite Commander and red triangle inline heading and paragraph", "kind": "clause", "box": [513071, 396464, 928922, 428662], "components": ["Elite Commander and red triangle inline heading and paragraph"], "uncertainty": [], "text": "Elite Commander: This refers to leaders with a triangle symbol\n(\u25b2) next to their Initiative; see 5.5 for use."}
{"i": 103, "key": "ig2b02:p7:rating-initiative", "label": "Initiative inline heading and paragraph", "kind": "clause", "box": [513071, 433712, 928922, 525884], "components": ["Initiative inline heading and paragraph"], "uncertainty": [], "text": "Initiative: Denotes his basic ability to control forces and make\nrapid decisions. Initiative is used to determine the order of leader\nactivation and the chances of that leader gaining a Momentum\nOrders Phase. It also defines the number of individual orders\nthat leader may issue each Orders Phase. The higher the rating,\nthe better the leader."}
{"i": 104, "key": "ig2b02:p7:rating-line-command", "label": "Line Command inline heading and paragraph", "kind": "clause", "box": [513071, 530934, 928922, 593435], "components": ["Line Command inline heading and paragraph"], "uncertainty": [], "text": "Line Command: The boxed number to the right of the Initia-\ntive Rating indicates that the leader, instead of issuing a series\nof Individual Orders to a given number of units, may issue that\nnumber of Line Commands."}
{"i": 105, "key": "ig2b02:p7:rating-strategy", "label": "Strategy inline heading and paragraph", "kind": "clause", "box": [513071, 598484, 928922, 630682], "components": ["Strategy inline heading and paragraph"], "uncertainty": [], "text": "Strategy: For Overall Commanders only, facilitates the use of\nLine Commands by Subordinate Commanders."}
{"i": 106, "key": "ig2b02:p7:rating-charisma", "label": "Charisma inline heading and paragraph", "kind": "clause", "box": [513071, 635732, 928922, 698233], "components": ["Charisma inline heading and paragraph"], "uncertainty": [], "text": "Charisma: Denotes his ability to spur his troops on to greater\nefforts in combat. The rating is used to adjust the die roll on the\nShock Combat Results Table in his favor for combat units with\nwhich he is stacked."}
{"i": 107, "key": "ig2b02:p7:charisma-design-note", "label": "Design note on Charisma", "kind": "note", "box": [513071, 700126, 928922, 797349], "components": ["Design note on Charisma"], "uncertainty": [], "text": "DESIGN NOTE: This rating is usually quite low in SPQR.\nCommanders of this era, except for the old-line Macedonians,\nhad abandoned the up-front and personal style of hands-\non leadership in favor of a more efficient, behind-the-lines\ncommand methodology. This enabled them to see (and thus\ncontrol) more."}
{"i": 108, "key": "ig2b02:p7:rating-movement-allowance", "label": "Movement Allowance inline heading and paragraph", "kind": "clause", "box": [513071, 804292, 928922, 881945], "components": ["Movement Allowance inline heading and paragraph"], "uncertainty": [], "text": "Movement Allowance: The number of Movement Points (MP)\na Leader may use in an Orders Phase. The MA, which is 9 for\nall leaders, is not printed on the counter. Commanders who have\nLeader Elephants (here, only Hannibal) use the same MA 9,\nregardless of the MA of the actual elephant."}
{"i": 109, "key": "ig2b02:p7:rating-command-restriction", "label": "Command Restriction inline heading and paragraph", "kind": "clause", "box": [513071, 886994, 928922, 934344], "components": ["Command Restriction inline heading and paragraph"], "uncertainty": [], "text": "Command Restriction: Certain leaders have a unit Type on\ntheir counter. If present, the leader cannot affect any other type\nof unit in any way (e.g., enable Shock)."}
{"i": 110, "key": "ig2b02:p7:copyright-footer", "label": "Copyright footer", "kind": "editorial", "box": [426470, 945707, 573530, 960228], "components": ["Copyright symbol", "2026 GMT Games, LLC"], "uncertainty": [], "text": "\u00a9 2026 GMT Games, LLC"}

