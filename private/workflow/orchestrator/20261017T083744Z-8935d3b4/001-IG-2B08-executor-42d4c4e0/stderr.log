+    artifacts={p['path']:p for p in index['artifacts']}
+    for p in qa['artifacts']:artifacts[p['path']]=p
+    index['artifacts']=list(artifacts.values());write(ROOT/'source-pins.json',index)
+    artifacts={}
+    def collect(o):
