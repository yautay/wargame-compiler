+'''
+    (ROOT/'delivery-handoff.md').write_text(handoff,encoding='utf-8',newline='\n')
+    pending=[c for c in TASK['acceptance'] if c.startswith('A fresh independent reviewer') or c.startswith('Independent review compares')]
