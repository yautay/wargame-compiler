ry)) if args.registry else None", "            doc=structural_inventory(root,args.pdf,args.provenance,args.source_id,args.sha256,registry)", "        else:", "            doc=load_json(safe_artifact(root,args.inventory)); validate(doc,root)", "            if len(args.pages)!=len(set(args.pages)) or any(p not in range(1,doc['source']['page_count']+1) for p in args.pages):", "                raise ValueError('invalid or duplicate verification page')", "        out=safe_artifact(root,args.output)", "        if out.exists(): raise ValueError('output must be new; immutable artifacts are never overwritten')", "        out.mkdir(parents=True,exist_ok=False)", "        if args.operation=='evidence':", "            for number in args.pages:", "                page=next(p for p in doc['pages'] if p['pdf_page']==number)", "                regions=[r for r in doc['regions'] if r['page_id']==page['id']]", "                for index,region in enumerate(regions):", "                    doc['evidence'].append(extract_evidence(doc,region['id'],root,f'{args.output}/page-{number:03d}-region-{index:03d}',dpi=args.dpi))", "                    doc=seal(doc)", "            doc=seal(doc)", "        report=validate(doc,root)", "        (out/'inventory.json').write_bytes(canonical_bytes(doc)+b'\\n')", "        (out/'identity-registry.json').write_bytes(canonical_bytes(doc['registry'])+b'\\n')", "        (out/'coverage.json').write_bytes(canonical_bytes(report)+b'\\n')", "        print(str(out)); return 0", "    except (ValueError,OSError) as error:", "        print(str(error),file=sys.stderr); return 1", "", "", "if __name__=='__main__': raise SystemExit(main())"], "truncated": false}

