ersion", "    pdf = safe_artifact(root,pdf_path)", "    pin = file_pin(root,pdf_path)", "    if pin['sha256']!=expected_sha256: raise ValueError('PDF input hash changed')", "    reader = PdfReader(pdf, strict=True)", "    geometry, count = source_structure(pdf,pdfinfo=pdfinfo)", "    poppler = subprocess.run([str(pdfinfo),'-v'],capture_output=True,text=True,check=True)", "    registry = copy.deepcopy(registry) if registry is not None else new_registry(source_id,expected_sha256)", "    validate_registry(registry)", "    if (registry['source_id'],registry['source_revision'])!=(source_id,expected_sha256):", "        raise ValueError('source changed; explicit page/region remapping required')", "    labels=reader.page_labels if '/PageLabels' in reader.trailer['/Root'] else None", "    pages=[]", "    for number,page in enumerate(reader.pages,1):", "        key=f'physical-page:{number}'", "        label = {'status':'embedded_unverified','value':str(labels[number-1]),'reason':'PDF PageLabels metadata, not visual printed-label verification','evidence':None} if labels else {'status':'unknown','value':None,'reason':'No verified printed label; PDF page number is separate','evidence':None}", "        pages.append(seal({'id':assign(registry,'page',key),'key':key,'source_revision':expected_sha256,", "                           'pdf_page':number,'label':label,**geometry[number]}))", "    if file_pin(root,pdf_path)!=pin: raise ValueError('PDF changed during inspection')", "    source={'id':source_id,'sha256':expected_sha256,'pdf':pin,'provenance':file_pin(root,provenance_path),", "            'page_count':count,'independent_counts':[{'tool':'pypdf','count':count},{'tool':'poppler-pdfinfo','count':count}]}", "    tools=[{'name':'pypdf','version':version},{'name':'poppler-pdfinfo','version':(poppler.stderr+poppler.stdout).strip()}]", "    return source,pages,registry,tools", "", "", "def structural_inventory(root, pdf_path, provenance_path, source_id, expected_sha256, registry=None, **options):", "    source,pages,registry,tools=inspect_pdf(root,pdf_path,provenance_path,source_id,expected_sha256,registry,**options)", "    regions=[make_region(registry,f'physical-page:{p[\"pdf_page\"]}:unprocessed-placeholder',p,[0,0,1_000_000,1_000_000],reason='Structural placeholder only; substantive inventory pending IG-2B') for p in pages]", "    return assemble(source,pages,regions,registry,toolchain=tools)", "", "", "def extract_evidence(document, region_id, root, output_directory, *, dpi=144, pdftoppm='pdftoppm'):", "    \"\"\"Write a new cropped PDF, UTF-8 text and PNG with independent exact pins.", "", "    Extraction order and OCR/meaning confidence are not reading-order decisions.", "    The clipped PDF is a derived artifact; original publisher bytes stay unchanged.", "    \"\"\"", "    from pypdf import PdfReader, PdfWriter, __version__ as pypdf_version", "    from pypdf.generic import RectangleObject, NameObject", "    import pdfplumber", "    from PIL import Image", "    from .inventory import validate", "    validate(document,root)", "    if type(dpi) is not int or not 36<=dpi<=600: raise ValueError('DPI must be an integer in 36..600')", "    region = next((r for r in document['regions'] if r['id']==region_id),None)"], "truncated": true}

