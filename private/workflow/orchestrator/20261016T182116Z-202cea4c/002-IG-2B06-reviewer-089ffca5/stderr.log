'@ | .venv/Scripts/python.exe -" in C:\repo\wargame-compiler
 succeeded in 387ms:
1: """Fresh task-local accounting, preservation and independent replay comparisons."""
2: import collections
3: import datetime
4: import importlib.metadata
5: import json
6: import os
7: from pathlib import Path
8: import shutil
9: import subprocess
10: import sys
11: 
12: from wgc.contracts.source import canonical_bytes
13: from wgc.sources.inventory import file_pin, digest, page_basis_hash, coverage
14: from wgc.sources.geometry import area
15: 
16: ROOT = Path.cwd()
17: RUN = Path('private/workflow/runs/IG-2B06/continuation-21-24-serial02')
18: SESSION = Path('private/workflow/orchestrator/20261016T182116Z-202cea4c/001-IG-2B06-executor-f2379326')
19: claim = json.loads((RUN/'claim.json').read_text())
20: META = {k:claim[k] for k in ('role','actor','model','reasoning','configuration_evidence','configuration_sha256','task')}
21: task = json.loads((SESSION/'task.json').read_text())
22: contract = json.loads(Path(task['refinement_contract']['path']).read_text())
23: scope = json.loads(Path(task['continuation_authorization']['scope']['path']).read_text())
24: baseline = json.loads(Path(contract['input_pins'][0]['path']).read_text())
25: base_registry = json.loads(Path(contract['input_pins'][1]['path']).read_text())
26: author = json.loads((RUN/'authored/inventory.json').read_text())
27: rows = json.loads((RUN/'author-regions.json').read_text())['regions']
28: docs = {name:json.loads((RUN/name/'inventory.json').read_text()) for name in ('replay-a','replay-b','final-verified')}
29: final = docs['final-verified']
30: page_by_id = {p['id']:p for p in final['pages']}
31: regions = {r['id']:r for r in final['regions']}
32: new_ids = {r['id'] for r in final['regions'] if r['key'].startswith('ig2b06:')}
33: assigned_ids = {rid for rid in new_ids if regions[rid]['denominator_role']=='inventory'}
34: context_ids = new_ids-assigned_ids
35: target_ids = set(task['source_scope']['target_ids'])
36: assert len(assigned_ids)==112 and len(context_ids)==2
37: 
38: def pin(path):
39:     return file_pin(ROOT,Path(path).as_posix())
40: 
41: COMMON = {'final_inventory':pin(RUN/'final-verified/inventory.json'),
42:           'final_registry':pin(RUN/'final-verified/identity-registry.json'),
43:           'input_packet':pin(SESSION/'packet.json'),'selected_task':pin(SESSION/'task.json'),
44:           'refinement_contract':pin(task['refinement_contract']['path']),
45:           'authored_input':pin(RUN/'authored/inventory.json'),
46:           'authored_registry':pin(RUN/'authored/identity-registry.json')}
47: 
48: def write(name,summary,**data):
49:     p=RUN/name
50:     assert not p.exists(),str(p)
51:     p.write_text(json.dumps({**META,'summary':summary,**COMMON,**data},indent=2)+'\n',encoding='utf-8')
52:     return pin(p)
53: 
54: # All original accepted records are compared internally, never dumped as context.
55: expected_regions = [r for r in baseline['regions'] if r['id'] not in target_ids]
56: old_ids = {r['id'] for r in baseline['regions']}
57: base_entries = {(e['kind'],e['key']):e['id'] for e in base_registry['entries']}
58: preservation_results = {}
59: for name,doc in docs.items():
60:     entries = {(e['kind'],e['key']):e['id'] for e in doc['registry']['entries']}
61:     checks = {
62:         'source_metadata_equal':doc['source']==baseline['source'],
63:         'all_44_page_records_equal':doc['pages']==baseline['pages'] and len(doc['pages'])==44,
64:         'all_nonassigned_regions_equal_in_original_relative_order':[r for r in doc['regions'] if r['id'] in old_ids]==expected_regions,
65:         'all_original_links_equal_prefix':doc['links'][:len(baseline['links'])]==baseline['links'],
66:         'all_original_evidence_equal_prefix':doc['evidence'][:len(baseline['evidence'])]==baseline['evidence'],
67:         'all_original_registry_bindings_retained':all(entries.get(k)==v for k,v in base_entries.items()),
68:         'exactly_four_placeholder_memberships_removed':old_ids-{r['id'] for r in doc['regions']}==target_ids,
69:         'retired_placeholder_registry_entries_retained':all(e in doc['registry']['entries'] for e in base_registry['entries'] if e['id'] in target_ids),
70:         'nonassigned_reading_order_equal':[rid for rid in doc['reading_order'] if rid in old_ids]==[rid for rid in baseline['reading_order'] if rid not in target_ids],
71:         'authored_regions_links_order_registry_equal':all(doc[k]==author[k] for k in ('regions','links','reading_order','registry','pages','source','toolchain')),
72:     }
73:     assert all(checks.values()),(name,checks)
74:     preservation_results[name]=checks
75: input_rechecks=[]
76: for x in contract['input_pins']+scope['drafts']+[scope['preserve_manifest'],scope['assessment'],scope['effective_refinement_contract']]:
77:     assert pin(x['path'])==x,x['path']; input_rechecks.append(x)
78: preserved=json.loads(Path(scope['preserve_manifest']['path']).read_text())
79: for x in preserved['artifacts']:
80:     actual=pin(x['path']); assert actual['sha256']==x['sha256'],x['path']
81: for ev in baseline['evidence']:
82:     for k in ('text','image','crop_pdf'):
83:         assert pin(ev[k]['path'])==ev[k]
