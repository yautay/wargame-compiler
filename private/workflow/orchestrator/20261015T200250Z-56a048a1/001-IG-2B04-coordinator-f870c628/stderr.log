+def sha(p):
+    return hashlib.sha256((ROOT / p).read_bytes()).hexdigest()
+
+def pin(p):
+    return {'path': p, 'sha256': sha(p), 'bytes': (ROOT / p).stat().st_size}
+
+def create(p, value):
+    with (ROOT / p).open('x', encoding='utf-8', newline='\n') as f:
+        json.dump(value, f, ensure_ascii=False, indent=2)
+        f.write('\n')
