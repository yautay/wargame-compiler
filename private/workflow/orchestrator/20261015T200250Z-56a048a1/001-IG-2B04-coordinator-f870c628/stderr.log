=='render':", "        validate(q,root,check_views=False); render(q,root); print('Rendered task/status views.'); return", "    if args.command=='files': print('\\n'.join(active_files(root))); return", "    validate(q,root)", "    ready=[t for t in q['tasks'] if t['status']=='ready']", "    if args.command=='validate': print(f'Validated {len(q[\"tasks\"])} tasks, DAG, scope, context and derived views.')", "    elif args.command=='next': print(ready[0]['id'] if ready else 'No ready task.')", "    elif args.command=='packet': packet(q,root,args.task or ready[0]['id'])", "    elif args.command=='dry-run':", "        before=digest(root/QUEUE); p=packet(q,root,args.task or ready[0]['id'],output=False)", "        assert before==digest(root/QUEUE)", "        print(json.dumps({'result':'passed','task':p['task'],'context_files':len(p['files']),", "                          'context_bytes':p['text_bytes'],'queue_unchanged':True,", "                          'models_launched':0,'product_files_written':0},indent=2))", "    elif args.command=='transition':", "        if not all((args.task,args.to,args.evidence)): raise ValueError('Specify --task, --to and --evidence')", "        lock=root/'private/workflow/queue.lock'; lock.parent.mkdir(parents=True,exist_ok=True)", "        # An abandoned lock requires coordinator diagnosis; never steal it automatically.", "        fd=os.open(lock,os.O_CREAT|os.O_EXCL|os.O_WRONLY)", "        try:", "            current=digest(root/QUEUE); q=read_json(root/QUEUE)", "            transition(q,root,args.task,args.to,args.evidence)", "            if digest(root/QUEUE)!=current: raise ValueError('Queue changed concurrently')", "            temp=root/'docs/work/queue.pending.json'", "            with temp.open('x',encoding='utf-8') as stream: json.dump(q,stream,ensure_ascii=False,indent=2); stream.write('\\n')", "            os.replace(temp,root/QUEUE); render(q,root)"], "truncated": true}

