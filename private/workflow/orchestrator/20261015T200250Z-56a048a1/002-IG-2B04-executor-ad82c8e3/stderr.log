+    for rec in records:
+        rec['id'] = assign(registry,'region',rec['key'])
+    save('authored-registry.json', registry)
+    save('authored-regions.json', {**COMMON,'format':'wgc-authored-inventory-spec-1','source':CONTRACT['inputs']['pdf'],
