+    assert retired == {r['id'] for r in baseline['regions'] if r['page_id'] in {pages[p]['id'] for p in (13,14,15,16)}}
+    regions = [r for r in baseline['regions'] if r['id'] not in retired] + authored
+    inserted=False
+    order=[]
