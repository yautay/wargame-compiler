+                candidates = sorted(range(y - 12, y + 13), key=lambda q: (abs(q-y), q))
+                for q in candidates:
+                    if not any(c['x0']*2 < x1 and c['x1']*2 > x0 and c['top']*2-1 < q < c['bottom']*2+1 for c in chars):
