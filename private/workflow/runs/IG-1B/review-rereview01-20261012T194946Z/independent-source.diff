+def verify_tree_names(directory, allowed_files):
+    """Inventory the exact sealed tree without following unlisted links.
+
+    Only metadata files and available manifest blobs may exist. Directories
+    must be the parents needed by those files; even extra empty directories
+    reject. No unexpected file content is opened during this inventory.
+    """
+    allowed_directories = set()
+    for name in allowed_files:
+        parent = Path(relative_path(name)).parent
+        while parent != Path('.'):
+            allowed_directories.add(parent.as_posix())
+            parent = parent.parent
+    actual_files = set()
+    actual_directories = set()
+    pending = [directory]
+    while pending:
+        current = pending.pop()
+        no_links(current)
+        with os.scandir(current) as entries:
+            for entry in entries:
+                info = entry.stat(follow_symlinks=False)
+                name = Path(entry.path).relative_to(directory).as_posix()
+                if stat.S_ISLNK(info.st_mode) or getattr(info, 'st_file_attributes', 0) & 1024:
+                    raise SnapshotError('linked path in snapshot tree: ' + name)
+                relative_path(name)
+                if stat.S_ISDIR(info.st_mode):
+                    if name not in allowed_directories:
+                        raise SnapshotError('unexpected directory in snapshot tree: ' + name)
+                    actual_directories.add(name)
+                    pending.append(Path(entry.path))
+                elif stat.S_ISREG(info.st_mode):
+                    if name not in allowed_files:
+                        raise SnapshotError('unexpected file in snapshot tree: ' + name)
+                    actual_files.add(name)
+                else:
+                    raise SnapshotError('non-regular entry in snapshot tree: ' + name)
+    if actual_files != allowed_files or actual_directories != allowed_directories:
+        raise SnapshotError('snapshot tree is missing declared files or parent directories')
+
