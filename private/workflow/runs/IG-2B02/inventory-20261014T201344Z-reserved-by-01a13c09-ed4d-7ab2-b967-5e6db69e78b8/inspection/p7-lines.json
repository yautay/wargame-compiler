      "x1": 452.676,
      "bottom": 240.78930000000003
    },
    {
      "column": "right",
      "text": "Each leader possesses several ratings:",
      "x0": 315.0,
      "top": 244.1753000000001,
      "x1": 466.07000000000005,
      "bottom": 254.1753000000001
    },
    {
      "column": "right",
      "text": "Command Range: The range in hexes over which the leader",
