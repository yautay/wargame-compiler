      "x0": 315.00000000000006,
      "top": 487.17529999999994,
      "x1": 503.05000000000007,
      "bottom": 497.17529999999994
    },
    {
      "column": "right",
      "text": "Charisma: Denotes his ability to spur his troops on to greater",
      "x0": 315.00000000000006,
      "top": 504.5752999999999,
      "x1": 567.014,
      "bottom": 514.5753
    },
    {
      "column": "right",
