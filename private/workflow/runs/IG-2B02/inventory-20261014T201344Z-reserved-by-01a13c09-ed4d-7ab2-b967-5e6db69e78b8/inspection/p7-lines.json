    {
      "column": "right",
      "text": "(▲) next to their Initiative; see 5.5 for use.",
      "x0": 315.0,
      "top": 326.9753,
      "x1": 486.54,
      "bottom": 336.9753
    },
    {
      "column": "right",
      "text": "Initiative: Denotes his basic ability to control forces and make",
      "x0": 315.0,
      "top": 344.3753,
      "x1": 567.0,
      "bottom": 354.3753
    },
    {
      "column": "right",
      "text": "rapid decisions. Initiative is used to determine the order of leader",
      "x0": 315.0,
      "top": 356.3753,
      "x1": 567.0199999999999,
      "bottom": 366.3753
    },
