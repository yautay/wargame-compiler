+def raw_pages(data: bytes, numbers: list[int]) -> tuple[int, list[dict]]:
+    """Desktop evidence, without legacy segmentation or inferred reading order.
+
+    Keep PDF character stream order and exact decoded strings. Consecutive glyphs
+    on the same baseline form a fragment; a wide gap or backwards move splits it.
+    No whitespace, labels, Unicode normalization or semantic blocks are invented.
+    Boxes use PDF points from the top left, rounded to 0.001 point.
+    """
+    try:
+        return _raw_pages(data, numbers)
+    except IngestError:
+        raise
+    except Exception as error:  # PDF decoding can fail after opening, as in _read_lines.
+        raise IngestError(f"Surowych dowodów PDF nie da się odczytać: {error}") from None
+
+
+def _raw_pages(data: bytes, numbers: list[int]) -> tuple[int, list[dict]]:
+    with _open_pdf(data) as document:
+        count = len(document.pages)
+        if not numbers or any(type(n) is not int or not 1 <= n <= count for n in numbers):
+            raise IngestError("Wybierz istniejące strony PDF (numeracja od 1).")
+        snapshots = []
+        for number in sorted(set(numbers)):
+            page = document.pages[number - 1]
+            width, height = round(page.width, 3), round(page.height, 3)
+            fragments, previous = [], None
+            for char in page.chars:
+                text = char["text"]
+                if not text:
+                    continue
+                box = [round(char[k], 3) for k in ("x0", "top", "x1", "bottom")]
+                if (not all(math.isfinite(v) for v in box)
+                        or not 0 <= box[0] < box[2] <= width
+                        or not 0 <= box[1] < box[3] <= height):
+                    # Do not silently drop visible text or manufacture its geometry.
+                    raise IngestError(f"Strona {number}: glif poza stroną lub z pustą geometrią; wymagany przegląd PDF.")
+                same_run = (previous is not None and abs(box[1] - previous[1]) <= .5
+                            and abs(box[3] - previous[3]) <= .5
+                            and -.01 <= box[0] - previous[2] <= CELL_GAP * max(char["size"], 1))
+                if not same_run:
+                    fragments.append({"ref": f"p{number}f{len(fragments) + 1}", "text": "", "bbox": box[:], "glyphs": []})
+                fragment = fragments[-1]
+                start = len(fragment["text"])
+                fragment["text"] += text
+                fragment["glyphs"].append({"start": start, "end": start + len(text), "bbox": box})
+                outer = fragment["bbox"]
+                fragment["bbox"] = [min(outer[0], box[0]), min(outer[1], box[1]),
+                                    max(outer[2], box[2]), max(outer[3], box[3])]
+                previous = box
+            snapshots.append({"pdf_page": number, "printed_label": None, "width": width,
+                              "height": height, "fragments": fragments})
+        return count, snapshots
+
+
