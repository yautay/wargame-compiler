      ],
      "source_ids": [
        "C-9.14-02"
      ],
      "parent_render_sha256": "fe980a86fe41c88c191f49842d896385f9c855ee7534581d446f97ff3f3e9fa3",
      "source_text": "Each Elephant Rampage is always resolved immediately, before\nany other game mechanic is addressed, except for Orderly With-\ndrawal in face of the rampaging elephant (6.51).",
      "transform": "crop only original render pixels"
    },
    {
      "file": {
